# Run one test case. Variables (passed via -D):
#   CASE_DIR     - path to test case
#   WORK_DIR     - scratch build dir
#   GEN          - "bison" or "yacc"
#   GEN_BIN      - generator executable
#   C_COMPILER   - C compiler
#   CXX_COMPILER - C++ compiler (used when driver.cc is present)

file(MAKE_DIRECTORY ${WORK_DIR})

# A test is C++ if driver.cc exists in the case dir.  C++ cases use g++,
# generate .tab.cc + .tab.hh, and link against the lalr1.cc skeleton.
set(IS_CXX 0)
if(EXISTS ${CASE_DIR}/driver.cc)
    set(IS_CXX 1)
endif()

# Read optional options.txt
set(EXTRA_OPTS "")
if(EXISTS ${CASE_DIR}/options.txt)
    file(STRINGS ${CASE_DIR}/options.txt EXTRA_OPTS_LINES)
    foreach(L ${EXTRA_OPTS_LINES})
        string(STRIP "${L}" L)
        if(L)
            list(APPEND EXTRA_OPTS ${L})
        endif()
    endforeach()
endif()

# Bison-specific options to silence yacc warnings (we want to focus on parser correctness)
if(GEN STREQUAL "bison")
    list(PREPEND EXTRA_OPTS "-Wno-yacc")
endif()

# Generate parser
file(COPY ${CASE_DIR}/grammar.y DESTINATION ${WORK_DIR})

if(IS_CXX)
    set(OUTPUT_SRC ${WORK_DIR}/grammar.tab.cc)
    set(OUTPUT_HDR ${WORK_DIR}/grammar.tab.hh)
else()
    set(OUTPUT_SRC ${WORK_DIR}/grammar.tab.c)
    set(OUTPUT_HDR ${WORK_DIR}/grammar.tab.h)
endif()

execute_process(
    COMMAND ${GEN_BIN} -d -o ${OUTPUT_SRC} ${EXTRA_OPTS} ${WORK_DIR}/grammar.y
    WORKING_DIRECTORY ${WORK_DIR}
    RESULT_VARIABLE GEN_RC
    OUTPUT_VARIABLE GEN_OUT
    ERROR_VARIABLE  GEN_ERR
)
if(NOT GEN_RC EQUAL 0)
    message(FATAL_ERROR "${GEN} failed (rc=${GEN_RC}):\nstdout: ${GEN_OUT}\nstderr: ${GEN_ERR}")
endif()

if(NOT EXISTS ${OUTPUT_SRC})
    message(FATAL_ERROR "${GEN} did not produce ${OUTPUT_SRC}")
endif()

set(EXE ${WORK_DIR}/test_prog)
if(WIN32)
    set(EXE ${EXE}.exe)
endif()

if(IS_CXX)
    set(DRIVER ${CASE_DIR}/driver.cc)
    if(NOT EXISTS ${DRIVER})
        message(FATAL_ERROR "missing driver.cc in ${CASE_DIR}")
    endif()
    file(COPY ${DRIVER} DESTINATION ${WORK_DIR})
    execute_process(
        COMMAND ${CXX_COMPILER} -std=c++17 -O0 -g -Wno-unused -Wno-free-nonheap-object
                -I${WORK_DIR} ${OUTPUT_SRC} ${WORK_DIR}/driver.cc -o ${EXE}
        RESULT_VARIABLE CC_RC
        OUTPUT_VARIABLE CC_OUT
        ERROR_VARIABLE  CC_ERR
    )
else()
    set(DRIVER ${CASE_DIR}/driver.c)
    if(NOT EXISTS ${DRIVER})
        message(FATAL_ERROR "missing driver.c in ${CASE_DIR}")
    endif()
    file(COPY ${DRIVER} DESTINATION ${WORK_DIR})
    execute_process(
        COMMAND ${C_COMPILER} -std=c11 -O0 -g -Wno-unused -Wno-implicit-fallthrough
                -Wno-deprecated-non-prototype -Wno-implicit-function-declaration
                -Wno-error=implicit-function-declaration
                -I${WORK_DIR} ${OUTPUT_SRC} ${WORK_DIR}/driver.c -o ${EXE}
        RESULT_VARIABLE CC_RC
        OUTPUT_VARIABLE CC_OUT
        ERROR_VARIABLE  CC_ERR
    )
endif()
if(NOT CC_RC EQUAL 0)
    message(FATAL_ERROR "compile failed (rc=${CC_RC}):\nstdout: ${CC_OUT}\nstderr: ${CC_ERR}")
endif()

# Run with input
set(STDIN_FILE ${CASE_DIR}/input.txt)
set(EXPECTED ${CASE_DIR}/expected.txt)
if(NOT EXISTS ${EXPECTED})
    message(FATAL_ERROR "missing expected.txt")
endif()
file(READ ${EXPECTED} EXPECTED_CONTENT)

if(EXISTS ${STDIN_FILE})
    execute_process(
        COMMAND ${EXE}
        INPUT_FILE ${STDIN_FILE}
        OUTPUT_VARIABLE ACTUAL
        ERROR_VARIABLE ACTUAL_ERR
        RESULT_VARIABLE RUN_RC
        TIMEOUT 30
    )
else()
    execute_process(
        COMMAND ${EXE}
        OUTPUT_VARIABLE ACTUAL
        ERROR_VARIABLE ACTUAL_ERR
        RESULT_VARIABLE RUN_RC
        TIMEOUT 30
    )
endif()

# Optionally compare with stderr too
if(EXISTS ${CASE_DIR}/expected_combined.txt)
    set(EXPECTED_FILE ${CASE_DIR}/expected_combined.txt)
    file(READ ${EXPECTED_FILE} EXPECTED_CONTENT)
    set(ACTUAL "${ACTUAL}${ACTUAL_ERR}")
endif()

# Normalize line endings and trailing whitespace
string(REPLACE "\r\n" "\n" ACTUAL "${ACTUAL}")
string(REPLACE "\r\n" "\n" EXPECTED_CONTENT "${EXPECTED_CONTENT}")
# Trim trailing newline whitespace differences
string(REGEX REPLACE "[\n ]+$" "" ACTUAL "${ACTUAL}")
string(REGEX REPLACE "[\n ]+$" "" EXPECTED_CONTENT "${EXPECTED_CONTENT}")

if(NOT "${ACTUAL}" STREQUAL "${EXPECTED_CONTENT}")
    message(FATAL_ERROR "Output mismatch (run_rc=${RUN_RC}):\n--- expected ---\n${EXPECTED_CONTENT}\n--- actual ---\n${ACTUAL}\n--- stderr ---\n${ACTUAL_ERR}\n")
endif()
